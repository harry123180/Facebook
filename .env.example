# ===== 複製成 .env 並填入自己的值 =====
# cp .env.example .env

# --- PostgreSQL (Docker compose) ---
POSTGRES_USER=fbapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=facebook_mvp
DATABASE_URL=postgresql+psycopg://fbapp:change-me@127.0.0.1:5435/facebook_mvp

# --- Flask ---
FLASK_APP=backend/wsgi.py
FLASK_DEBUG=1
SECRET_KEY=change-me
FRONTEND_ORIGIN=http://localhost:5173
PORT=8000
# auto = 依對外協定自動決定 cookie 的 Secure 旗標（X-Forwarded-Proto / Cf-Visitor）
# 1   = 一律標 Secure；0 = 一律不標
SESSION_COOKIE_SECURE=auto

# --- Resend ---
# https://resend.com/api-keys
RESEND_API_KEY=re_change-me
RESEND_FROM_EMAIL=Facebook MVP <onboarding@resend.dev>
RESEND_FROM_NAME=Facebook MVP
# auto    = 先試真實寄信；Resend testing mode 擋下收件人時自動降級成 console（驗證碼印 log 並回傳 dev_code）
# console = 一律不寄信
# resend  = 一律真實寄信，失敗就回 502
EMAIL_BACKEND=auto

# --- 郵件驗證碼 ---
VERIFY_CODE_TTL_SECONDS=600
VERIFY_CODE_RESEND_COOLDOWN_SECONDS=60
VERIFY_CODE_MAX_ATTEMPTS=5

# --- NPC（用 opencode 當 LLM 引擎）---
# 單次回覆逾時秒數
NPC_TIMEOUT=120
# 預熱逾時（首次載入模型較久）
NPC_WARMUP_TIMEOUT=300
# 建立 NPC 時先在背景預熱 opencode session（讓第一則回覆不用等 30s+）
NPC_WARMUP=1
# 預設模型（格式 provider/model）
NPC_DEFAULT_MODEL=ollama/qwen36-nothink
